<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Рестораны Эмброуз</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poiret+One&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<!-- Баннер -->
<div id="container-wrap">
    <div id="header">
        <img src="/assets/logo.png" alt="Логотип" class="logo-left">
        <h1>Рестораны Эмброуз</h1>
        <img src="/assets/logo.png" alt="Логотип" class="logo-right">
    </div>
</div>

<!-- Навигация -->
<nav>
    <a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">Главная</a>
    <a href="/menu" class="<%= currentPage === 'menu' ? 'active' : '' %>">Меню</a>
    <% if (user) { %>
        <a href="/cart" class="<%= currentPage === 'cart' ? 'active' : '' %>">Корзина</a>
        <a href="/orders" class="<%= currentPage === 'orders' ? 'active' : '' %>">Мои заказы</a>
        <% if (user.roles.includes('Admin')) { %>
            <a href="/admin/orders" class="<%= currentPage === 'admin' ? 'active' : '' %>">Заказы (админ)</a>
        <% } %>
        <a href="/logout">Выйти (<%= user.fullName || user.email %>)</a>
    <% } else { %>
        <a href="/login" class="<%= currentPage === 'login' ? 'active' : '' %>">Войти</a>
    <% } %>
</nav>