<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Рестораны Эмброуз</title>
    <!-- Шрифт Poiret One (основной) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poiret+One&display=swap" rel="stylesheet">
    <style>
        /* Скопируйте сюда ВСЕ ваши CSS-стили из оригинального index.html */
        :root {
            --text-color: #dbf7d8;
            --active-color: #966522;
            --element-bg: #20003c;
            --border-color: #a38800;
            --font-family: 'Poiret One', cursive;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: var(--font-family); color: var(--text-color); background: #ffffff; line-height: 1.6; }

        /* Баннер */
        #container-wrap {
            background: url('https://scpfoundation.net/local--files/theme:golden-feast/background.png') center top repeat-x;
            background-size: 224px 400px;
            width: 100%;
            min-height: 280px;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            position: relative;
            overflow: visible;
        }
        #header {
            width: 100%;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            padding-top: 40px;
        }
        .logo-left, .logo-right {
            width: 80px;
            height: auto;
            position: absolute;
            top: 65%;
            transform: translateY(-50%);
            transition: all 0.3s;
        }
        .logo-left { left: 8%; }
        .logo-right { right: 8%; }
        #header h1 {
            font-family: var(--font-family);
            font-size: 50px;
            color: #fff;
            text-shadow: 1px 1px 3px black;
            text-align: center;
            letter-spacing: 0.5px;
            z-index: 2;
            margin: 0;
        }
        @media (max-width: 499px) {
            #header h1 { font-size: 28px; }
            .logo-left, .logo-right { width: 50px; top: 70%; }
            .logo-left { left: 5%; }
            .logo-right { right: 5%; }
            #header { padding-top: 40px; }
        }

        /* Навигация */
        nav {
            background: var(--element-bg);
            border-top: 4px solid var(--border-color);
            border-bottom: 4px solid var(--border-color);
            text-align: center;
            padding: 12px 0;
            font-family: var(--font-family);
        }
        nav a {
            color: var(--text-color);
            text-decoration: none;
            margin: 0 25px;
            font-size: 20px;
            font-weight: bold;
            padding: 8px 18px;
            border-radius: 6px;
            transition: background 0.2s, color 0.2s;
        }
        nav a.active, nav a:hover {
            background: var(--active-color);
            color: #fff;
        }

        /* Основной контейнер */
        .content {
            background: var(--element-bg);
            border: 3px solid var(--border-color);
            border-radius: 16px;
            max-width: 1100px;
            margin: 30px auto;
            padding: 30px 25px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
            font-family: var(--font-family);
            color: var(--text-color);
        }

        /* Карточки блюд */
        .popular-dishes {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: center;
            margin-bottom: 40px;
        }
        .dish-card {
            background: rgba(255,255,255,0.05);
            border: 2px solid var(--border-color);
            border-radius: 16px;
            width: 230px;
            padding: 15px;
            text-align: center;
            transition: transform 0.2s;
        }
        .dish-card:hover { transform: scale(1.03); }
        .dish-card img {
            width: 100%;
            height: 140px;
            object-fit: cover;
            border-radius: 12px;
            margin-bottom: 10px;
            border: 1px solid var(--border-color);
        }
        .dish-card h3 {
            font-size: 1.2em;
            margin: 8px 0 5px;
            color: #fff;
        }
        .dish-card .price {
            font-weight: bold;
            color: var(--border-color);
            font-size: 1.1em;
        }

        /* Текстовые блоки */
        .about, .founders { margin-top: 30px; text-align: left; }
        .about p, .founders p { margin-bottom: 1em; font-size: 1.1em; }
        .founders h2 { text-align: center; color: #fff; margin-bottom: 20px; font-size: 1.8em; }
        blockquote {
            font-style: italic;
            margin: 20px 0;
            padding: 15px 25px;
            border-left: 4px solid var(--border-color);
            background: rgba(255,255,255,0.05);
            border-radius: 0 8px 8px 0;
            font-size: 1.1em;
        }
        blockquote footer {
            text-align: right;
            font-style: normal;
            font-weight: bold;
            margin-top: 10px;
            color: #fff;
        }
        hr {
            border: 1px solid var(--border-color);
            margin: 25px 0;
            opacity: 0.5;
        }
    </style>
</head>
<body>

<!-- Баннер -->
<div id="container-wrap">
    <div id="header">
        <img src="/assets/logo.png" alt="Логотип" class="logo-left">
        <h1>Рестораны Эмброуз</h1>
        <img src="/assets/logo.png" alt="Логотип" class="logo-right">
    </div>
</div>

<!-- Навигация (активный пункт можно менять динамически) -->
<nav>
    <a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">Главная</a>
    <a href="/menu" class="<%= currentPage === 'menu' ? 'active' : '' %>">Меню</a>
    <a href="/order" class="<%= currentPage === 'order' ? 'active' : '' %>">Заказ</a>
    <a href="/login" class="<%= currentPage === 'login' ? 'active' : '' %>">Войти</a>
</nav>