<%- include('partials/header', { currentPage: 'menu' }) %>

<div class="content">
    <h2 style="text-align:center; color:#fff;">Добавить блюдо (Администратор)</h2>
    <% if (error) { %><p style="color:red; text-align:center;"><%= error %></p><% } %>
    <form action="/menu/add" method="POST" style="max-width: 500px; margin: 0 auto;">
        <input type="text" name="name" placeholder="Название" required style="display:block; width:100%; padding:8px; margin-bottom:10px;">
        <input type="number" step="0.01" name="price" placeholder="Цена" required style="display:block; width:100%; padding:8px; margin-bottom:10px;">
        <textarea name="description" placeholder="Описание" style="display:block; width:100%; padding:8px; margin-bottom:10px; height:80px;"></textarea>
        <input type="text" name="image_url" placeholder="Путь к изображению (assets/...)" style="display:block; width:100%; padding:8px; margin-bottom:10px;">
        <!-- Жёстко зададим категорию, пока без выпадающего списка. Позже можно улучшить. -->
        <select name="category_id" required style="display:block; width:100%; padding:8px; margin-bottom:10px;">
            <option value="">Выберите категорию</option>
            <option value="1">Супы</option>
            <option value="2">Горячее</option>
            <option value="3">Напитки</option>
            <option value="4">Десерты</option>
        </select>
        <button type="submit" class="btn" style="width:100%;">Добавить</button>
    </form>
</div>

<%- include('partials/footer') %>